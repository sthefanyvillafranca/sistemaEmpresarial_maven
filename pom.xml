<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.example</groupId>
  <artifactId>sistemaEmpresarial</artifactId>
  <version>1.0-SNAPSHOT</version>
  <name>SistemaEmpresarial - Maven + JUnit</name>

  <properties>
    <!-- versión de Java con la que se compila y codificación de los archivos -->
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>

    <!-- driver de mysql (antes era el .jar de la carpeta driver).
         Es la misma versión que aquel .jar: mysql-connector-j 26.7.0 -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>26.7.0</version>
    </dependency>

    <!-- Pruebas JUNIT: scope test = solo se puede usar dentro de src/test -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.0</version>
      <scope>test</scope>
    </dependency>

  </dependencies>

</project>
